# saas-edu/backend/.env
APP_NAME=SaasEdu
DEBUG=false
ENVIRONMENT=production
API_V1_PREFIX=/api/v1

# Database (overrideado por docker-compose, este valor es para dev local)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saas_edu
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/saas_edu

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security — CAMBIA ESTO EN PRODUCCIÓN
SECRET_KEY=super-secret-key-de-64-caracteres-minimo-0123456789abcdef0123456789abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# LLM — Groq (obtén tu clave en https://console.groq.com)
# Si está vacía el sistema usará respuestas dummy para testing
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_PERSIST_DIR=/data/chroma

# Documentos
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=512
CHUNK_OVERLAP=50
UPLOAD_DIR=/data/uploads

# CORS
CORS_ORIGINS=["http://localhost:3000"]