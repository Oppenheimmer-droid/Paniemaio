# ===========================================
# APP
# ===========================================
APP_NAME=SaasEdu
DEBUG=true
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# ===========================================
# DATABASE — PostgreSQL
# ===========================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/saas_edu
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@postgres:5432/saas_edu

# ===========================================
# REDIS — Celery Broker
# ===========================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===========================================
# SECURITY — CAMBIAR EN PRODUCCIÓN
# ===========================================
SECRET_KEY=cambia-esto-en-produccion-minimo-64-caracteres-abcdefghijklmnopqrstuvwxyz123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===========================================
# LLM — Groq (gratuito)
# ===========================================
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ===========================================
# EMBEDDINGS — Local (costo cero)
# ===========================================
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===========================================
# CHROMADB
# ===========================================
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=/data/chroma

# ===========================================
# DOCUMENTOS
# ===========================================
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=512
CHUNK_OVERLAP=50
UPLOAD_DIR=/data/uploads

# ===========================================
# CORS — Desarrollo local
# ===========================================
CORS_ORIGINS=["http://localhost:3000"]